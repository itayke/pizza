// Static site on Workers: no script, the Vite build is served as assets
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pizza",
  "compatibility_date": "2026-11-19",
  "assets": { "directory": "./dist" },
  // Served only on the custom domain; deploy creates its DNS record and certificate
  "routes": [{ "pattern": "pizza.untame.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
